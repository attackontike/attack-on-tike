---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "AI에 관심 있는 사람들을 위한 실전 정보" } = Astro.props;
---

<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Attack on Tike</title>
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <header class="header">
      <div class="container">
        <a href="/" class="logo">Attack on Tike</a>
        <nav>
          <a href="/tools">Tools</a>
          <a href="/launches">Launches</a>
          <a href="/workflows">Workflows</a>
          <a href="/stories">Stories</a>
          <a href="/weekly">Weekly</a>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <p>© 2026 Attack on Tike. 거인은 아니지만, 진격은 한다.</p>
      </div>
    </footer>
  </body>
</html>